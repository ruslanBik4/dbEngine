}

func (dst *{%s typeName %}) DecodeDatabaseSQLValue(m *pgtype.Map, oid uint32, format int16, src []byte) (driver.Value, error) {
	if src == nil {
		return nil, nil
	}

	switch format {
	case pgtype.TextFormatCode:
		return string(src), nil

	case pgtype.BinaryFormatCode:
		buf := make([]byte, len(src))
		copy(buf, src)
		return buf, nil

	default:
		return nil, fmt.Errorf("unknown format code %d", format)
	}
}

func (dst *{%s typeName %}) DecodeValue(m *pgtype.Map, oid uint32, format int16, src []byte) (any, error) {
	if src == nil {
		return nil, nil
	}
	{% if t.Type == 'r' -%}
	typ, ok := m.TypeForName("{%s elemPgName %}")
	if !ok {
		return nil, fmt.Errorf("unable to find pgtype for range element %q", "{%s elemPgName %}")
	}

	return (&pgtype.RangeCodec{ElementType: typ}).DecodeValue(m, typ.OID, format, src)
	{% else -%}
	if format != pgtype.BinaryFormatCode {
		return nil, fmt.Errorf("DecodeValue: unsupported format code %d", format)
	}

	values := make(map[string]any, {%d len(t.Attr) %})
	c := pgtype.NewCompositeBinaryScanner(m, src)

	{% for _, attr := range t.Attr -%}
	if !c.Next() {
		return nil, c.Err()
	}
	{
		var v any
		fieldPlan := m.PlanScan(c.OID(), pgtype.BinaryFormatCode, &v)
		if fieldPlan == nil {
			return nil, fmt.Errorf("unable to scan OID %d in binary format into field %q", c.OID(), "{%s attr.Name %}")
		}
		if err := fieldPlan.Scan(c.Bytes(), &v); err != nil {
			return nil, err
		}
		values["{%s attr.Name %}"] = v
	}
	{% endfor %}

	return values, c.Err()
	{% endif -%}
}
// Scan implement pgtype.ScanPlan interface
func (dst *{%s typeName %}) ScanIndex(i int) any {
	switch i {
	{% for i, attr := range t.Attr %}case {%d i %}:
        return &dst.{%s strcase.ToCamel(attr.Name) %}
    {% endfor %}
   	default:
		panic("invalid index")
	}
}
// Scan implement pgtype.ScanPlan interface. PlanScan (below) hands back this same
// method regardless of which *{%s typeName %} it happens to be called on - a
// registered Codec is a single shared instance reused for every row/column of this
// OID, so the actual per-call destination is always the `target` argument, never
// this method's own receiver.
func (dst *{%s typeName %}) Scan(src []byte, target any) error {
	*dst = target.({%s typeName %})
	if len(src) == 0 {
		return nil
	}
	m := pgtype.NewMap()
	{% if t.Type == 'r' %}
	typ, ok := m.TypeForName("{%s elemPgName %}")
	if !ok {
		return fmt.Errorf("unable to find pgtype for range element %q", "{%s elemPgName %}")
	}

	err := new(pgtype.RangeCodec{ElementType: typ}).PlanScan(m, typ.OID, pgtype.BinaryFormatCode, target).Scan(src, &dst)
	if err != nil {
		return err
	}
	{% else %}

	c := pgtype.NewCompositeBinaryScanner(m, src)

	for i := range c.FieldCount() {
        //	    rich end of elements
        if !c.Next() {
            return nil
        }

        field := dst.ScanIndex(i)
        fieldPlan := m.PlanScan(c.OID(), pgtype.BinaryFormatCode, field)
        if fieldPlan == nil {
            return fmt.Errorf("unable to scan OID %d in text format into '%d'", c.OID(), i)
        }

        if err := fieldPlan.Scan(c.Bytes(), field); err != nil {
			return err
		}
	}
	{%- endif -%}

	return nil
}

