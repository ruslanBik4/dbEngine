{%- func CreateTableConstructor(goName, name string) -%}
// New{%s goName %} create new instance of table {%s goName %}
func (d *Database) New{%s goName %}(ctx context.Context) (*{%s goName %}, error) {
	switch table, err := New{%s goName %}(d.DB); err.(type) {
	case nil:
		return table, nil

	// no found on Database - get data of table from Conn
	case dbEngine.ErrNotFoundTable:
		table, err := New{%s goName %}FromConn(ctx, d.PsqlConn())
		if err != nil {
			return nil, err
		}
		d.Tables[table.Name()] = table
		return table, nil
		
	default:
		return nil, err
	}
}
{% endfunc %}